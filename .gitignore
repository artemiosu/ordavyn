.*-private/

# Local replay journals and SQLite sidecars (never publish application state).
*.sqlite
*.sqlite3
*.db
*-journal
*-wal
*-shm

# Unreviewed root source documents stay local, independent of local excludes.
/*.md
!/README.md
!/AGENTS.md
!/CHANGELOG.md
!/CODE_OF_CONDUCT.md
!/CONTRIBUTING.md
!/SECURITY.md
